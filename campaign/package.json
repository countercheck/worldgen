{
  "name": "campaign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "predev": "npm run build -w @campaign/shared",
    "dev": "npm run dev -w @campaign/server & npm run dev -w @campaign/client & wait",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run build && npm run e2e -w @campaign/client",
    "lint": "eslint .",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
