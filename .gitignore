.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# The campaign/ TypeScript workspace. `dist/` is already covered above; these are the
# rest of what npm and tsc leave behind. package-lock.json is deliberately NOT ignored —
# it is the only record of what the server actually ran with.
node_modules/
*.tsbuildinfo
dist-tsc/
coverage/
# What the browser tests leave: the demonstration campaign's stored link, and the traces
# and reports of a failed run.
campaign/client/e2e/.state/
test-results/
playwright-report/
# The dev server's SQLite file, and the journals beside it. A campaign somebody played
# locally is not a repository artifact.
campaign.db*

# Generated worlds and map exports. `output/` is the default --output-dir, and
# `output*/` catches the ones named per map size while measuring;
# my_world/ is a hand-named one. The root-only patterns catch stray exports
# without blocking images committed under docs/ or assets/.
output*/
my_world/
/*.svg
/*.png

.claude/worktrees/
.claude/cache/
.claude/*.local.*
# Claude Code settings. Machine-specific: the hook these carry holds an absolute
# path, and permission entries accumulate per session with scratchpad paths in
# them. `.claude/skills/` and friends stay tracked; only the settings do not.
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
